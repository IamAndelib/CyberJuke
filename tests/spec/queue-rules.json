        { "op": "expect", "current": "X", "upNext": ["b", "c"], "queued": 0 }
      ]
    },
    {
      "name": "repeat one replays the track when it ends; a user skip plays the queued one",
      "list": ["a", "b", "c"],
      "start": 0,
      "repeat": "one",
      "steps": [
        { "op": "queueNext", "ids": ["X"] },
        { "op": "nextAuto" },
        {
          "op": "expect",
          "current": "a",
          "upNext": ["X", "b", "c"],
          "queued": 1
        },
        { "op": "next" },
        { "op": "expect", "current": "X", "upNext": ["b", "c"], "queued": 0 }
      ]
    },
    {
      "name": "shuffled: queued tracks still play next, before and after a skip",
      "list": ["a", "b", "c", "d", "e", "f"],
      "start": 0,
