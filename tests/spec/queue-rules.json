      "steps": [
        { "op": "queueNext", "ids": ["X", "Y"] },
        { "op": "move", "id": "Y", "to": 1 },
        { "op": "expect", "current": "a", "upNext": ["Y", "X", "b", "c", "d"], "queued": 2 },
        { "op": "skipTo", "id": "c" },
        { "op": "expect", "current": "c", "upNext": ["Y", "X", "b", "d"], "queued": 2 }
