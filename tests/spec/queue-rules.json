          "op": "expect",
          "current": "a",
          "upNextStartsWith": ["X", "Y"],
          "queued": 2
        },
        { "op": "skipTo", "id": "e" },
        {
          "op": "expect",
          "current": "e",
          "upNextStartsWith": ["X", "Y"],
          "queued": 2
        },
        { "op": "setShuffle", "on": false },
        {
          "op": "expect",
          "current": "e",
          "upNextStartsWith": ["X", "Y"],
          "queued": 2
        },
        { "op": "setShuffle", "on": true },
        {
          "op": "expect",
          "current": "e",
          "upNextStartsWith": ["X", "Y"],
          "queued": 2
        }
      ]
    },
    {
      "name": "a removed queued track is forgotten; the rest stay next",
      "list": ["a",  "b",  "c",  "d",  "e"],
      "start": 0,
      "steps": [
