        {
          "op": "expect",
          "current": "a",
          "upNext": ["Q1", "Q2", "b", "c"],
          "queuedIds": ["Q1", "Q2"],
          "listIds": ["b", "c"]
        }
      ]
    },
    {
      "name": "restore: never at or before the current track",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "steps": [
        { "op": "remove", "id": "b" },
        { "op": "nextAuto" },
        { "op": "restore", "id": "b", "kind": "list", "beforeId": "c" },
        { "op": "expect", "current": "c", "upNext": ["d", "b"], "list": ["a", "c", "d", "b"] }
      ]
    },
    {
      "name": "restore: a list track with no anchor goes after the list, before autoplay",
      "list": ["a", "b"],
      "start": 0,
      "steps": [
        { "op": "queueNext", "ids": ["Q"] },
        { "op": "addAuto", "ids": ["s1"] },
        { "op": "restore", "id": "z", "kind": "list", "beforeId": null },
        { "op": "expect", "upNext": ["Q", "b", "z", "s1"], "queuedIds": ["Q"], "listIds": ["b", "z"], "autoplayIds": ["s1"] }
      ]
    },
    {
      "name": "restore: a queued track goes back into the queued run, never after list tracks",
      "list": ["a", "b"],
      "start": 0,
      "steps": [
        { "op": "queueNext", "ids": ["X", "Y", "Z"] },
        { "op": "remove", "id": "Y" },
        { "op": "restore", "id": "Y", "kind": "queued", "beforeId": "Z" },
        { "op": "expect", "upNext": ["X", "Y", "Z", "b"], "queuedIds": ["X", "Y", "Z"] },
        { "op": "remove", "id": "Z" },
        { "op": "restore", "id": "Z", "kind": "queued", "beforeId": "b" },
        { "op": "expect", "upNext": ["X", "Y", "Z", "b"], "queuedIds": ["X", "Y", "Z"], "listIds": ["b"] }
      ]
    },
    {
      "name": "restore: an autoplay track goes back into autoplay (its anchor, else the end)",
      "list": ["a"],
      "start": 0,
      "steps": [
        { "op": "addAuto", "ids": ["s1", "s2", "s3"] },
        { "op": "remove", "id": "s2" },
        { "op": "restore", "id": "s2", "kind": "autoplay", "beforeId": "s3" },
        { "op": "expect", "upNext": ["s1", "s2", "s3"], "autoplayIds": ["s1", "s2", "s3"] },
        { "op": "remove", "id": "s1" },
        { "op": "nextAuto" },
        { "op": "restore", "id": "s1", "kind": "autoplay", "beforeId": "s2" },
        { "op": "expect", "current": "s2", "upNext": ["s3", "s1"], "autoplayIds": ["s3", "s1"] }
      ]
    },
    {
      "name": "restore: the anchor must be in the same section",
      "list": ["a", "b"],
      "start": 0,
      "steps": [
        { "op": "queueNext", "ids": ["Q"] },
        { "op": "restore", "id": "X", "kind": "queued", "beforeId": "b" },
        { "op": "restore", "id": "z", "kind": "list", "beforeId": "Q" },
        { "op": "expect", "upNext": ["Q", "X", "b", "z"], "queuedIds": ["Q", "X"], "listIds": ["b", "z"] }
      ]
    },
    {
      "name": "removeIds: every match goes; the current one moves on to the next that stays",
      "list": ["a", "m1", "m2", "b"],
      "start": 1,
      "steps": [
        { "op": "queueNext", "ids": ["m3"] },
        { "op": "addAuto", "ids": ["s1"] },
        { "op": "removeIds", "ids": ["m1", "m2", "m3"] },
        { "op": "expect", "current": "b", "upNext": ["s1"], "list": ["a", "b", "s1"], "queued": 0 },
        { "op": "removeIds", "ids": ["a", "b", "s1"] },
        { "op": "expect", "current": null, "upNext": [], "list": [] }
      ]
    },
    {
      "name": "restore: a played track goes back before the played track that followed it",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "steps": [
        { "op": "nextAuto" },
        { "op": "nextAuto" },
        { "op": "remove", "id": "a" },
        { "op": "expect", "current": "c", "played": ["b"] },
        { "op": "restore", "id": "a", "kind": "played", "beforeId": "b" },
        { "op": "expect", "current": "c", "played": ["a", "b"], "upNext": ["d"], "list": ["a", "b", "c", "d"] }
      ]
    },
    {
      "name": "restore: the last played track goes back right before the current one",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "steps": [
        { "op": "nextAuto" },
        { "op": "nextAuto" },
        { "op": "remove", "id": "b" },
        { "op": "restore", "id": "b", "kind": "played", "beforeId": null },
        { "op": "expect", "current": "c", "played": ["a", "b"], "upNext": ["d"], "list": ["a", "b", "c", "d"] }
      ]
    },
    {
      "name": "restore: with shuffle on, a played track goes back where it played",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "shuffle": true,
      "steps": [
        { "op": "queueNext", "ids": ["Q"] },
        { "op": "nextAuto" },
        { "op": "queueNext", "ids": ["R"] },
        { "op": "nextAuto" },
        { "op": "expect", "current": "R", "played": ["a", "Q"] },
        { "op": "remove", "id": "a" },
        { "op": "restore", "id": "a", "kind": "played", "beforeId": "Q" },
        { "op": "expect", "current": "R", "played": ["a", "Q"], "listSet": ["b", "c", "d"] }
      ]
    },
    {
      "name": "a played track moved past the current one plays next, after the queued ones",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "steps": [
        { "op": "nextAuto" },
        { "op": "nextAuto" },
        { "op": "move", "id": "a", "to": 2 },
        { "op": "expect", "current": "c", "played": ["b"], "upNext": ["a", "d"], "list": ["b", "c", "a", "d"] },
        { "op": "queueNext", "ids": ["Q"] },
        { "op": "move", "id": "b", "to": 2 },
        { "op": "expect", "current": "c", "played": [], "upNext": ["Q", "b", "a", "d"], "queuedIds": ["Q"], "listIds": ["b", "a", "d"] },
        { "op": "setRepeat", "mode": "all" },
        { "op": "next" },
        { "op": "next" },
        { "op": "expect", "current": "b", "played": ["c", "Q"] }
      ]
    },
    {
      "name": "a list started mid-way has played nothing: the tracks before it weren't heard",
      "list": ["a", "b", "c", "d", "e"],
      "start": 2,
      "steps": [
        { "op": "expect", "current": "c", "played": [], "upNext": ["d", "e"] },
        { "op": "next" },
        { "op": "expect", "current": "d", "played": ["c"] }
      ]
    },
    {
      "name": "shuffle on mixes every track not heard yet, also those before where the list started",
      "list": ["a", "b", "c", "d"],
      "start": 2,
      "steps": [
        { "op": "setShuffle", "on": true },
        { "op": "expect", "current": "c", "played": [], "listSet": ["a", "b", "d"] }
      ]
    },
    {
      "name": "shuffle off shows as played only what was heard",
      "list": ["a", "b", "c", "d", "e"],
      "start": 2,
      "shuffle": true,
      "steps": [
        { "op": "queueNext", "ids": ["Q"] },
        { "op": "nextAuto" },
        { "op": "setShuffle", "on": false },
        { "op": "expect", "current": "Q", "played": ["c"], "upNext": ["d", "e"] }
      ]
    },
    {
      "name": "a radio (one song, then suggestions) shuffles its suggestions; new ones mix in; a tap keeps what it jumps over",
      "list": ["a"],
      "start": 0,
      "steps": [
        { "op": "addAuto", "ids": ["s1", "s2", "s3", "s4", "s5"] },
        { "op": "setShuffle", "on": true },
        { "op": "expect", "current": "a", "played": [], "listIds": [], "autoplaySet": ["s1", "s2", "s3", "s4", "s5"] },
        { "op": "addAuto", "ids": ["t1", "t2"] },
        { "op": "expect", "current": "a", "autoplaySet": ["s1", "s2", "s3", "s4", "s5", "t1", "t2"] },
        { "op": "setShuffle", "on": false },
        { "op": "expect", "current": "a", "autoplayIds": ["s1", "s2", "s3", "s4", "s5", "t1", "t2"] },
        { "op": "setShuffle", "on": true },
        { "op": "skipTo", "id": "s4" },
        { "op": "expect", "current": "s4", "played": ["a"], "autoplaySet": ["s1", "s2", "s3", "s5", "t1", "t2"] }
      ]
    },
    {
      "name": "a tapped suggestion, then shuffle on: the songs it jumped over stay ahead",
      "list": ["a", "b", "c"],
      "start": 0,
      "steps": [
        { "op": "addAuto", "ids": ["s1", "s2"] },
        { "op": "skipTo", "id": "s1" },
        { "op": "setShuffle", "on": true },
        { "op": "expect", "current": "s1", "played": ["a"], "listSet": ["b", "c"], "autoplaySet": ["s2"] },
        { "op": "setShuffle", "on": false },
        { "op": "expect", "current": "s1", "upNext": ["b", "c", "s2"] }
      ]
    },
    {
      "name": "with shuffle on, a tapped suggestion keeps the list ahead of it",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "shuffle": true,
      "steps": [
        { "op": "addAuto", "ids": ["s1", "s2"] },
        { "op": "skipTo", "id": "s2" },
        { "op": "expect", "current": "s2", "played": ["a"], "listSet": ["b", "c", "d"], "autoplaySet": ["s1"] }
      ]
    },
    {
      "name": "with shuffle on, Previous after a tapped suggestion leaves it next",
      "list": ["a", "b", "c", "d"],
      "start": 0,
      "shuffle": true,
      "steps": [
        { "op": "addAuto", "ids": ["s1", "s2"] },
        { "op": "skipTo", "id": "s2" },
        { "op": "prev", "positionMs": 0 },
        { "op": "expect", "current": "a", "upNextStartsWith": ["s2"] },
        { "op": "next" },
        { "op": "expect", "current": "s2" }
      ]
    },
    {
      "name": "shuffle on keeps the suggestions heard behind, as played",
      "list": ["a"],
      "start": 0,
      "steps": [
        { "op": "addAuto", "ids": ["s1", "s2", "s3", "s4"] },
        { "op": "next" },
        { "op": "next" },
        { "op": "skipTo", "id": "a" },
        { "op": "setShuffle", "on": true },
        { "op": "expect", "current": "a", "played": ["s1", "s2"], "autoplaySet": ["s3", "s4"] }
      ]
    }
  ]
}
