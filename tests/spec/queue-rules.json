        { "op": "prev", "positionMs": 5000 },
        {
          "op": "expect",
          "current": "c",
          "upNext": ["X", "d", "e"],
          "queued": 1
        },
        { "op": "prev", "positionMs": 0 },
        {
          "op": "expect",
          "current": "b",
          "upNext": ["X", "c", "d", "e"],
          "queued": 1
        }
      ]
    },
