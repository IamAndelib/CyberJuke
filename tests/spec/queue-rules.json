        { "op": "remove", "id": "X" },
        { "op": "expect", "current": "a", "upNext": ["Y", "b", "c", "d", "e"], "queued": 1 },
        { "op": "skipTo", "id": "d" },
        { "op": "expect", "current": "d", "upNext": ["Y", "b", "c", "e"], "queued": 1 }
