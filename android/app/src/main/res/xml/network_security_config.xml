<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere (Android 7.0-8.1 allow it by default): every request the app makes,
     WebView and native, is https. User-added CAs are not trusted (the platform default). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
