<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (API 31+). Older versions use full_backup_content.xml; keep the
  two in sync.

  Never backed up or transferred to a new phone:
  - sharedpref/cyberjuke_secure.xml: the SecureStore ciphertext (Cyberspace refresh token). Its
    Keystore key never leaves the device, so a copy is useless elsewhere anyway.
  - files/cyberjuke/: the web side's data files (catalog-public.json, catalog-members.json,
    history.json, liked.json, members-kept.json: each account's members-only likes and plays,
    kept for its next sign-in). The members-only catalog, and history and liked tracks that can contain
    members-only tracks, must not end up in a cloud backup or on another device. (Liked was in
    CapacitorStorage.xml before 1.1.1; the app moves it on first start.)
  - sharedpref/last_session.xml: where in the last queue playback was. The queue itself is in
    no_backup/last-session.json, which Android never backs up.
  - database/exoplayer_internal.db: the listening cache's index (which videos' audio is kept,
    liked and members-only ones among them). The audio itself, its liked list and its
    members-only tags are in no_backup/ (audio/, audio-liked, audio-members), which Android
    never backs up, as are the saved liked songs (no_backup/saved/, indexed in the same
    database) and their covers (no_backup/art/).
  The cache directory (lyrics) is never backed up by Android.

  disableIfNoEncryptionCapabilities: what is left (settings, recent searches) goes to the cloud
  only in an end-to-end encrypted backup, which needs a screen lock. full_backup_content.xml
  has no such switch (only per-<include> flags), so on Android 11 and older it stays as it was.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="cyberjuke_secure.xml" />
        <exclude domain="sharedpref" path="last_session.xml" />
        <exclude domain="file" path="cyberjuke/" />
        <exclude domain="database" path="exoplayer_internal.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cyberjuke_secure.xml" />
        <exclude domain="sharedpref" path="last_session.xml" />
        <exclude domain="file" path="cyberjuke/" />
        <exclude domain="database" path="exoplayer_internal.db" />
    </device-transfer>
</data-extraction-rules>
