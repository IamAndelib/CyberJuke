{
  "name": "cyberjuke",
  "private": true,
  "version": "1.0.0",
  "description": "Unofficial music-streaming Android app for the Cyberspace Jukebox",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "playwright test --project=e2e",
    "e2e:live": "PW_LIVE=1 playwright test --project=e2e --grep @live",
    "sync": "npm run build && cap sync android",
    "screenshots": "playwright test --project=screenshots",
    "media": "bash scripts/make-media.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
