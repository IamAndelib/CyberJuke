    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
