{
  "name": "cyberjuke",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial music-streaming Android app for the Cyberspace Jukebox",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
